{
  "schemaVersion": 1,
  "routes": [
    {
      "path": "/",
      "methods": [
        "GET",
        "HEAD"
      ],
      "generatedAsset": false,
      "status": 302
    },
    {
      "path": "/__locale",
      "methods": [
        "GET"
      ],
      "generatedAsset": false,
      "status": 303
    }
  ],
  "cases": [
    {
      "id": "root-default",
      "path": "/",
      "headers": {},
      "expectedStatus": 302,
      "expectedLocation": "/ja/"
    },
    {
      "id": "root-cookie",
      "path": "/",
      "headers": {
        "Cookie": "cfgb_locale=en",
        "Accept-Language": "ja"
      },
      "expectedStatus": 302,
      "expectedLocation": "/en/"
    },
    {
      "id": "root-quality",
      "path": "/",
      "headers": {
        "Accept-Language": "ja;q=0.2, en-US;q=0.9"
      },
      "expectedStatus": 302,
      "expectedLocation": "/en/"
    },
    {
      "id": "root-zero-quality",
      "path": "/",
      "headers": {
        "Accept-Language": "en;q=0, ja;q=0.5"
      },
      "expectedStatus": 302,
      "expectedLocation": "/ja/"
    },
    {
      "id": "root-unsupported",
      "path": "/",
      "headers": {
        "Cookie": "cfgb_locale=fr",
        "Accept-Language": "fr"
      },
      "expectedStatus": 302,
      "expectedLocation": "/ja/"
    },
    {
      "id": "locale-valid-next",
      "path": "/__locale?lang=en&next=%2Fen%2Fabout%2F",
      "expectedStatus": 303,
      "expectedLocation": "/en/about/",
      "expectedCookieLocale": "en"
    },
    {
      "id": "locale-external-next",
      "path": "/__locale?lang=en&next=https%3A%2F%2Fevil.invalid%2F",
      "expectedStatus": 303,
      "expectedLocation": "/en/",
      "expectedCookieLocale": "en"
    },
    {
      "id": "locale-network-next",
      "path": "/__locale?lang=en&next=%2F%2Fevil.invalid%2F",
      "expectedStatus": 303,
      "expectedLocation": "/en/",
      "expectedCookieLocale": "en"
    },
    {
      "id": "locale-wrong-locale-next",
      "path": "/__locale?lang=en&next=%2Fja%2Fabout%2F",
      "expectedStatus": 303,
      "expectedLocation": "/en/",
      "expectedCookieLocale": "en"
    },
    {
      "id": "root-simplified-chinese",
      "path": "/",
      "headers": {
        "Accept-Language": "zh-CN"
      },
      "expectedStatus": 302,
      "expectedLocation": "/zh-Hans/"
    },
    {
      "id": "root-korean",
      "path": "/",
      "headers": {
        "Accept-Language": "ko-KR"
      },
      "expectedStatus": 302,
      "expectedLocation": "/ko/"
    },
    {
      "id": "root-traditional-chinese-fallback",
      "path": "/",
      "headers": {
        "Accept-Language": "zh-TW"
      },
      "expectedStatus": 302,
      "expectedLocation": "/ja/"
    },
    {
      "id": "root-chinese-cookie",
      "path": "/",
      "headers": {
        "Cookie": "cfgb_locale=zh-Hans",
        "Accept-Language": "ja"
      },
      "expectedStatus": 302,
      "expectedLocation": "/zh-Hans/"
    },
    {
      "id": "locale-zh-Hans-next",
      "path": "/__locale?lang=zh-Hans&next=%2Fzh-Hans%2Fabout%2F",
      "expectedStatus": 303,
      "expectedLocation": "/zh-Hans/about/",
      "expectedCookieLocale": "zh-Hans"
    },
    {
      "id": "locale-ko-next",
      "path": "/__locale?lang=ko&next=%2Fko%2Fabout%2F",
      "expectedStatus": 303,
      "expectedLocation": "/ko/about/",
      "expectedCookieLocale": "ko"
    }
  ],
  "allResponses": {
    "cacheControlIncludes": [
      "no-store"
    ]
  },
  "rootVary": [
    "Cookie",
    "Accept-Language"
  ],
  "cookie": {
    "name": "cfgb_locale",
    "secure": true,
    "httpOnly": true,
    "sameSite": "Lax",
    "path": "/",
    "maxAge": 31536000
  },
  "rootCacheControl": "private, no-store"
}
