{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "initial-import",
      "steps": [
        "inventory all pages",
        "load approved decisions",
        "plan full URL map",
        "apply"
      ],
      "expected": {
        "publishedVariants": 3,
        "pairedGroups": 1,
        "uniqueOwnedAssets": 1,
        "conversionReview": 2,
        "excludedDrafts": 1
      },
      "expectedModelCalls": 0
    },
    {
      "id": "identical-rerun",
      "steps": [
        "apply baseline",
        "apply same plan again"
      ],
      "expected": "byte-identical tree and manifest",
      "expectedModelCalls": 0
    },
    {
      "id": "manual-target-edit",
      "steps": [
        "apply baseline",
        "append human paragraph to ja introduction",
        "rerun unchanged source"
      ],
      "expected": "preserve edit and report local change",
      "expectedModelCalls": 0
    },
    {
      "id": "source-and-target-edit",
      "steps": [
        "apply baseline",
        "edit source body",
        "edit local target body",
        "plan and apply"
      ],
      "expected": "E_CONFLICT; preserve local target",
      "expectedReport": "expected/conflicts/source-and-target-changed.json",
      "expectedManifestUnchanged": true,
      "expectedSidecarsUnchanged": true,
      "expectedModelCalls": 0
    },
    {
      "id": "source-only-edit",
      "steps": [
        "apply baseline",
        "edit source body",
        "plan new replacement"
      ],
      "expected": "reviewable replacement; no write until apply",
      "expectedModelCalls": 0
    },
    {
      "id": "occupied-unowned-target",
      "steps": [
        "create unrelated target at planned path",
        "apply baseline"
      ],
      "expected": "E_CONFLICT; preserve existing file",
      "expectedReport": "expected/conflicts/unowned-target.json",
      "expectedManifestEntryCreated": false,
      "expectedSidecarsUnchanged": true,
      "expectedModelCalls": 0
    },
    {
      "id": "interrupted-apply",
      "steps": [
        "interrupt after target rename before manifest write",
        "resume using journal"
      ],
      "expected": "recover matching write or report conflict; no duplicate assets",
      "expectedModelCalls": 0
    },
    {
      "id": "forward-fragment-link",
      "steps": [
        "plan ja intro before ja followup"
      ],
      "expected": "/ja/posts/imported-followup/#続き",
      "expectedModelCalls": 0
    },
    {
      "id": "deterministic-pairing-without-ai",
      "steps": [
        "unset all AI credentials",
        "inventory synthetic snapshot",
        "plan without approved pairing decisions",
        "repeat plan from identical snapshot and CFGB version",
        "load approved decisions and plan again"
      ],
      "expected": "byte-identical candidate reports on repeated plan; unapproved candidates stay separate; only explicit decisions create pairs",
      "expectedModelCalls": 0,
      "expectedAutomaticPairing": false
    }
  ]
}
