{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "preview-access-explicit-true",
      "operations": [
        {
          "op": "setConfig",
          "pointer": "/security/previewAccess",
          "value": true
        }
      ],
      "expectedExit": 0,
      "expectedEffectivePreviewAccess": true,
      "stage": "load"
    },
    {
      "id": "preview-access-omitted",
      "operations": [
        {
          "op": "removeConfig",
          "pointer": "/security/previewAccess"
        }
      ],
      "expectedExit": 0,
      "expectedEffectivePreviewAccess": true,
      "stage": "load"
    },
    {
      "id": "security-omitted",
      "operations": [
        {
          "op": "removeConfig",
          "pointer": "/security"
        }
      ],
      "expectedExit": 0,
      "expectedEffectivePreviewAccess": true,
      "stage": "load"
    },
    {
      "id": "preview-access-false",
      "operations": [
        {
          "op": "setConfig",
          "pointer": "/security/previewAccess",
          "value": false
        }
      ],
      "expectedExit": 0,
      "stage": "load",
      "expectedEffectivePreviewAccess": false
    },
    {
      "id": "production-branch-explicit-master",
      "operations": [
        {
          "op": "setConfig",
          "pointer": "/deploy/productionBranch",
          "value": "master"
        }
      ],
      "expectedExit": 0,
      "expectedEffectiveProductionBranch": "master",
      "stage": "load"
    },
    {
      "id": "production-branch-omitted",
      "operations": [
        {
          "op": "removeConfig",
          "pointer": "/deploy/productionBranch"
        }
      ],
      "expectedExit": 0,
      "expectedEffectiveProductionBranch": "main",
      "stage": "load"
    },
    {
      "id": "deploy-section-omitted",
      "operations": [
        {
          "op": "removeConfig",
          "pointer": "/deploy"
        }
      ],
      "expectedExit": 0,
      "expectedEffectiveProductionBranch": "main",
      "stage": "load"
    },
    {
      "id": "production-branch-invalid-ref",
      "operations": [
        {
          "op": "setConfig",
          "pointer": "/deploy/productionBranch",
          "value": "master..old"
        }
      ],
      "expectedError": "E_DEPLOY_TARGET",
      "expectedExit": 2,
      "stage": "command",
      "command": "deploy"
    },
    {
      "id": "ai-enabled-empty-summary",
      "operations": [
        {
          "op": "setConfig",
          "pointer": "/ai/enabled",
          "value": true
        }
      ],
      "expectedError": "E_PROVIDER_CONFIG",
      "expectedExit": 2,
      "stage": "command",
      "command": "summarize"
    }
  ]
}
