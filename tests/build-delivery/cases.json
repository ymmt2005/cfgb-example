{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "build-no-upload",
      "command": "build --out dist",
      "expectedUploadCalls": 0,
      "expectedSourceFilesAdded": [],
      "expectedExit": 0
    },
    {
      "id": "deploy-same-artifact",
      "command": "deploy --from dist",
      "branch": "main",
      "expectedRebuildCalls": 0,
      "expectedUploadArtifact": "verified-input-artifact",
      "expectedExit": 0
    },
    {
      "id": "preview-same-artifact",
      "command": "preview --from dist",
      "branch": "post/test",
      "accessVerified": true,
      "expectedRebuildCalls": 0,
      "expectedUploadArtifact": "verified-input-artifact",
      "expectedExit": 0
    },
    {
      "id": "modified-artifact",
      "command": "deploy --from dist",
      "mutation": "modify site bytes after build finalizes the artifact manifest and output hashes",
      "expectedError": "E_ARTIFACT",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "stale-source",
      "command": "preview --from dist",
      "mutation": "change source commit after build",
      "expectedError": "E_BUILD_SOURCE",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "future-date-build",
      "command": "build --out dist",
      "publishedAt": "2099-01-01T00:00:00Z",
      "expectedWarning": "W_FUTURE_DATE",
      "expectedExit": 0,
      "expectedUploadCalls": 0
    },
    {
      "id": "future-date-production",
      "command": "deploy --from dist",
      "branch": "main",
      "publishedAt": "2099-01-01T00:00:00Z",
      "expectedError": "E_FUTURE_DATE",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "future-date-preview",
      "command": "preview --from dist",
      "branch": "post/future",
      "publishedAt": "2099-01-01T00:00:00Z",
      "accessVerified": true,
      "expectedExit": 0
    },
    {
      "id": "main-preview",
      "command": "preview --from dist",
      "branch": "main",
      "expectedError": "E_DEPLOY_TARGET",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "branch-production",
      "command": "deploy --from dist",
      "branch": "post/test",
      "expectedError": "E_DEPLOY_TARGET",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "unprotected-preview",
      "command": "preview --from dist",
      "branch": "post/test",
      "accessVerified": false,
      "expectedError": "E_PREVIEW_ACCESS",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "fork-pr",
      "event": "external-fork-pull-request",
      "expectedPrivilegedCredentials": false,
      "expectedAutomaticPreview": false
    },
    {
      "id": "unsupported-node",
      "command": "build --out dist",
      "mutation": "actual Node version outside release nodeRange",
      "expectedError": "E_TOOLCHAIN",
      "expectedExit": 2,
      "expectedRendererCalls": 0,
      "expectedUploadCalls": 0
    },
    {
      "id": "wrong-pnpm",
      "command": "build --out dist",
      "mutation": "actual pnpm differs from exact release requirement",
      "expectedError": "E_TOOLCHAIN",
      "expectedExit": 2,
      "expectedRendererCalls": 0,
      "expectedUploadCalls": 0
    },
    {
      "id": "missing-same-build-toolchain",
      "command": "deploy --from dist",
      "environment": "workers-builds",
      "mutation": "remove retained toolchain session after successful build",
      "expectedError": "E_TOOLCHAIN",
      "expectedExit": 2,
      "expectedRebuildCalls": 0,
      "expectedUploadCalls": 0
    },
    {
      "id": "detached-workers-checkout",
      "command": "build --out dist",
      "environment": {
        "WORKERS_CI": "1",
        "WORKERS_CI_COMMIT_SHA": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "WORKERS_CI_BRANCH": "post/test",
        "WORKERS_CI_BUILD_UUID": "build-example-001"
      },
      "git": {
        "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "branch": null
      },
      "expectedManifest": {
        "sourceCommit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "sourceBranch": "post/test",
        "buildUUID": "build-example-001",
        "provenanceProvider": "workers-builds"
      },
      "expectedWorkspace": {
        "parent": "os.TempDir()",
        "basenamePattern": "cfgb-build-*",
        "manifestIdEqualsBasename": true,
        "rawBuildIdChoosesPath": false,
        "distinctAcrossBuilds": true
      },
      "expectedExit": 0
    },
    {
      "id": "partial-workers-provenance",
      "command": "build --out dist",
      "environment": {
        "WORKERS_CI": "1",
        "WORKERS_CI_COMMIT_SHA": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expectedError": "E_BUILD_SOURCE",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "workers-commit-mismatch",
      "command": "build --out dist",
      "environment": {
        "WORKERS_CI": "1",
        "WORKERS_CI_COMMIT_SHA": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "WORKERS_CI_BRANCH": "post/test",
        "WORKERS_CI_BUILD_UUID": "build-example-001"
      },
      "git": {
        "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "branch": null
      },
      "expectedError": "E_BUILD_SOURCE",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "wrong-build-uuid",
      "command": "preview --from dist",
      "environment": "workers-builds",
      "mutation": "current opaque WORKERS_CI_BUILD_UUID differs from the build identifier recorded in the artifact manifest",
      "expectedError": "E_BUILD_SOURCE",
      "expectedExit": 1,
      "expectedUploadCalls": 0,
      "artifactBuildUUID": "build-example-001",
      "currentBuildUUID": "build-example-002"
    },
    {
      "id": "transferred-artifact-toolchain",
      "command": "deploy --from dist",
      "branch": "main",
      "environment": "outside-original-build",
      "mutation": "no original toolchain workspace; verified artifact and same CFGB release available",
      "expectedToolchainRecreation": true,
      "expectedRebuildCalls": 0,
      "expectedArtifactBytesUnchanged": true,
      "expectedExit": 0
    },
    {
      "id": "first-worker-preview-access",
      "command": "preview --from dist",
      "branch": "post/test",
      "access": {
        "destinationType": "preview_worker",
        "workerIdMatches": true,
        "reviewedPoliciesSafe": true,
        "previewUrlExistsBeforeUpload": false
      },
      "accessVerified": true,
      "expectedExit": 0,
      "expectedReadinessRequiresPostUploadChecks": true
    },
    {
      "id": "wrong-access-worker",
      "command": "preview --from dist",
      "branch": "post/test",
      "access": {
        "destinationType": "preview_worker",
        "workerIdMatches": false
      },
      "expectedError": "E_PREVIEW_ACCESS",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "preview-public-bypass",
      "command": "preview --from dist",
      "branch": "post/test",
      "access": {
        "destinationType": "preview_worker",
        "workerIdMatches": true,
        "publicBypass": true
      },
      "expectedError": "E_PREVIEW_ACCESS",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "opaque-build-id-path-safety",
      "command": "build --out dist",
      "environment": {
        "WORKERS_CI": "1",
        "WORKERS_CI_COMMIT_SHA": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "WORKERS_CI_BRANCH": "post/test",
        "WORKERS_CI_BUILD_UUID": "../build/opaque\\segment"
      },
      "git": {
        "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "branch": null
      },
      "expectedManifest": {
        "buildUUID": "../build/opaque\\segment",
        "provenanceProvider": "workers-builds"
      },
      "expectedWorkspace": {
        "parent": "os.TempDir()",
        "basenamePattern": "cfgb-build-*",
        "manifestIdEqualsBasename": true,
        "rawBuildIdChoosesPath": false
      },
      "expectedRawBuildIdUsedAsPath": false,
      "expectedExit": 0
    },
    {
      "id": "empty-workers-build-id",
      "command": "build --out dist",
      "environment": {
        "WORKERS_CI": "1",
        "WORKERS_CI_COMMIT_SHA": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "WORKERS_CI_BRANCH": "post/test",
        "WORKERS_CI_BUILD_UUID": ""
      },
      "git": {
        "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "branch": null
      },
      "expectedError": "E_BUILD_SOURCE",
      "expectedExit": 1,
      "expectedRendererCalls": 0,
      "expectedUploadCalls": 0
    },
    {
      "id": "runtime-config-production",
      "command": "deploy --from dist",
      "branch": "main",
      "releaseRequirements": {
        "workerCompatibilityDate": "2026-10-03"
      },
      "executionDate": "2026-11-04",
      "expectedWranglerConfig": {
        "compatibility_date": "2026-10-03",
        "workers_dev": false,
        "preview_urls": true,
        "previews": {}
      },
      "expectedAssetsTopLevel": true,
      "expectedRebuildCalls": 0,
      "expectedExit": 0
    },
    {
      "id": "runtime-config-preview",
      "command": "preview --from dist",
      "branch": "post/test",
      "releaseRequirements": {
        "workerCompatibilityDate": "2026-10-03"
      },
      "executionDate": "2026-11-04",
      "expectedWranglerConfig": {
        "compatibility_date": "2026-10-03",
        "workers_dev": false,
        "preview_urls": true,
        "previews": {}
      },
      "expectedAssetsTopLevel": true,
      "expectedRebuildCalls": 0,
      "expectedExit": 0
    },
    {
      "id": "worker-runtime-date-mismatch",
      "command": "deploy --from dist",
      "branch": "main",
      "releaseRequirements": {
        "workerCompatibilityDate": "2026-10-03"
      },
      "mutation": "artifact toolchain.workerCompatibilityDate changed to 2026-10-02",
      "expectedError": "E_ARTIFACT",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "missing-worker-runtime-date",
      "command": "build --out dist",
      "mutation": "embedded release requirements omit workerCompatibilityDate",
      "expectedError": "E_TOOLCHAIN",
      "expectedExit": 2,
      "expectedRendererCalls": 0,
      "expectedUploadCalls": 0
    },
    {
      "id": "custom-production-deploy",
      "command": "deploy --from dist",
      "productionBranch": "master",
      "branch": "master",
      "expectedRebuildCalls": 0,
      "expectedUploadArtifact": "verified-input-artifact",
      "expectedExit": 0
    },
    {
      "id": "custom-production-preview-rejected",
      "command": "preview --from dist",
      "productionBranch": "master",
      "branch": "master",
      "expectedError": "E_DEPLOY_TARGET",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "main-deploy-rejected-for-master",
      "command": "deploy --from dist",
      "productionBranch": "master",
      "branch": "main",
      "expectedError": "E_DEPLOY_TARGET",
      "expectedExit": 1,
      "expectedUploadCalls": 0
    },
    {
      "id": "main-preview-for-master",
      "command": "preview --from dist",
      "productionBranch": "master",
      "branch": "main",
      "accessVerified": true,
      "expectedRebuildCalls": 0,
      "expectedUploadArtifact": "verified-input-artifact",
      "expectedExit": 0
    }
  ]
}
